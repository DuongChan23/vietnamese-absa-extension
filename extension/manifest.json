{
  "manifest_version": 3,
  "name": "Vietnamese ABSA Analyzer (Local)",
  "description": "Persistent side-panel review analyzer powered by local ABSA FastAPI.",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Mở bảng phân tích ABSA"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}